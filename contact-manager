import unittest
import json
import os

TEST_FILE = "test_contacts_data.json"


class TestContactManagement(unittest.TestCase):

    def setUp(self):
        self.sample_contacts = [
            {
                "id": 1,
                "name": "John Doe",
                "phone": "9876543210",
                "email": "john@example.com",
                "address": "New York"
            }
        ]

        with open(TEST_FILE, "w") as file:
            json.dump(self.sample_contacts, file, indent=4)

    def tearDown(self):
        if os.path.exists(TEST_FILE):
            os.remove(TEST_FILE)

    def test_load_contacts(self):
        with open(TEST_FILE, "r") as file:
            contacts = json.load(file)

        self.assertEqual(len(contacts), 1)
        self.assertEqual(contacts[0]["name"], "John Doe")

    def test_add_contact(self):
        with open(TEST_FILE, "r") as file:
            contacts = json.load(file)

        new_contact = {
            "id": 2,
            "name": "Jane Smith",
            "phone": "9123456780",
            "email": "jane@example.com",
            "address": "California"
        }

        contacts.append(new_contact)

        with open(TEST_FILE, "w") as file:
            json.dump(contacts, file, indent=4)

        with open(TEST_FILE, "r") as file:
            updated_contacts = json.load(file)

        self.assertEqual(len(updated_contacts), 2)
        self.assertEqual(updated_contacts[1]["name"], "Jane Smith")

    def test_delete_contact(self):
        with open(TEST_FILE, "r") as file:
            contacts = json.load(file)

        contacts = [c for c in contacts if c["id"] != 1]

        with open(TEST_FILE, "w") as file:
            json.dump(contacts, file, indent=4)

        with open(TEST_FILE, "r") as file:
            updated_contacts = json.load(file)

        self.assertEqual(len(updated_contacts), 0)

    def test_search_contact(self):
        with open(TEST_FILE, "r") as file:
            contacts = json.load(file)

        result = next(
            (c for c in contacts if c["name"] == "John Doe"),
            None
        )

        self.assertIsNotNone(result)
        self.assertEqual(result["phone"], "9876543210")


if __name__ == "_main_":
    unittest.main()

